<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="BuildingPanel.uss" />
    <ui:VisualElement name="building-panel-root" class="building-panel-root">
        <ui:VisualElement name="building-panel-header" class="building-panel-header">
            <ui:Label name="building-panel-title" class="building-panel-title" />
            <ui:Button name="building-panel-close" text="x" class="building-panel-close" />
        </ui:VisualElement>
        <ui:ScrollView name="building-panel-slots" class="building-panel-slots" />
    </ui:VisualElement>
</ui:UXML>
