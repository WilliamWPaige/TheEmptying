<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="PeoplePanel.uss" />
    <ui:VisualElement name="people-panel-root" class="people-panel-root">
        <ui:VisualElement name="people-panel-header" class="people-panel-header">
            <ui:Label text="People" name="people-panel-title" class="people-panel-title" />
            <ui:Button name="people-panel-close" text="x" class="people-panel-close" />
        </ui:VisualElement>
        <ui:ScrollView name="people-panel-rows" class="people-panel-rows" />
    </ui:VisualElement>
</ui:UXML>
