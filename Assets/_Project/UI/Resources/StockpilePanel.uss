.stockpile-panel-root {
    position: absolute;
    top: 320px;
    right: 8px;
    width: 260px;
    max-height: 50%;
    background-color: rgb(20, 20, 24);
    border-radius: 6px;
    padding: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.stockpile-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.stockpile-panel-title {
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.stockpile-panel-close {
    width: 22px;
    height: 22px;
}

.stockpile-panel-goods {
    flex-grow: 1;
}
