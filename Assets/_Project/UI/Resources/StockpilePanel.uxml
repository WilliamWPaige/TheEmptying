<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="StockpilePanel.uss" />
    <ui:VisualElement name="stockpile-panel-root" class="stockpile-panel-root">
        <ui:VisualElement name="stockpile-panel-header" class="stockpile-panel-header">
            <ui:Label text="Stockpile" name="stockpile-panel-title" class="stockpile-panel-title" />
            <ui:Button name="stockpile-panel-close" text="x" class="stockpile-panel-close" />
        </ui:VisualElement>
        <ui:ScrollView name="stockpile-panel-goods" class="stockpile-panel-goods" />
    </ui:VisualElement>
</ui:UXML>
