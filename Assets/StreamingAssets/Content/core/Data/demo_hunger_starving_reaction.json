{
    "type": "rule",
    "items": [
        {
            "id": "rule.demo_hunger.starving_reaction",
            "name": "Demo Hunger: Starving Reaction",
            "description": "Milestone 2 check (prompt 2.8b): the demo hunger module's starving reaction, rebuilt as a rule. Listens for event.demo_hunger.hunger_changed and posts event.demo_hunger.starving the moment an entity's hunger crosses below 20, exactly like the C# version it replaced.",
            "enabled": true,
            "nodes": [
                { "id": "trigger", "blockType": "block.trigger.on_event", "x": 40, "y": 160, "fields": { "event": "event.demo_hunger.hunger_changed" } },
                { "id": "readEntity", "blockType": "block.value.read_event_parameter.entity", "x": 40, "y": 320, "fields": { "parameter": "entity" } },
                { "id": "readPrevious", "blockType": "block.value.read_event_parameter.number", "x": 40, "y": 0, "fields": { "parameter": "previousHunger" } },
                { "id": "readCurrent", "blockType": "block.value.read_event_parameter.number", "x": 40, "y": 80, "fields": { "parameter": "hunger" } },
                { "id": "wasAbove", "blockType": "block.value.compare_numbers", "x": 320, "y": 0, "fields": { "operator": ">=", "b": 20 } },
                { "id": "isBelow", "blockType": "block.value.compare_numbers", "x": 320, "y": 80, "fields": { "operator": "<", "b": 20 } },
                { "id": "justCrossed", "blockType": "block.value.and", "x": 600, "y": 40, "fields": {} },
                { "id": "branch", "blockType": "block.flow.branch", "x": 880, "y": 160, "fields": {} },
                { "id": "post", "blockType": "block.action.post_event", "x": 1160, "y": 160, "fields": { "event": "event.demo_hunger.starving", "param1Name": "entity" } }
            ],
            "connections": [
                { "fromNode": "trigger", "fromPort": "then", "toNode": "branch", "toPort": "exec" },
                { "fromNode": "readPrevious", "fromPort": "result", "toNode": "wasAbove", "toPort": "a" },
                { "fromNode": "readCurrent", "fromPort": "result", "toNode": "isBelow", "toPort": "a" },
                { "fromNode": "wasAbove", "fromPort": "result", "toNode": "justCrossed", "toPort": "a" },
                { "fromNode": "isBelow", "fromPort": "result", "toNode": "justCrossed", "toPort": "b" },
                { "fromNode": "justCrossed", "fromPort": "result", "toNode": "branch", "toPort": "condition" },
                { "fromNode": "branch", "fromPort": "true", "toNode": "post", "toPort": "exec" },
                { "fromNode": "readEntity", "fromPort": "result", "toNode": "post", "toPort": "param1" }
            ]
        }
    ]
}
